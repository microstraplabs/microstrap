{
  "manifest_version": 3,
  "name": "Microstrap for Roblox",
  "version": "0.1.8",
  "description": "Give Roblox a Microstrap orange-to-red look, customize the experience, and keep your familiar Roblox navigation.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.roblox.com/*"],
  "action": {
    "default_title": "Microstrap settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "css": ["theme.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
