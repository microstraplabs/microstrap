<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dashboard.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="My Dashboard" Width="700" Height="500"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="8" Title="My Dashboard" Icon="pack://application:,,,/Microstrap.ico" />
        <StackPanel Grid.Row="1" Margin="24,18,24,10">
            <TextBlock Text="Your creations" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,14" Text="Saved projects are available globally to this Microstrap installation and can be selected from Appearance settings." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ListBox x:Name="ThemesList" ItemsSource="{Binding}" MinHeight="220" SelectionChanged="ThemesList_SelectionChanged">
                <ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Launcher / app theme project" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="Saved globally" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,20">
            <ui:Button Content="New project" Icon="Add28" Click="New_Click" Margin="0,0,8,0" />
            <ui:Button x:Name="EditButton" Content="Edit" Icon="Edit28" Click="Edit_Click" IsEnabled="False" Margin="0,0,8,0" />
            <ui:Button x:Name="DeleteButton" Content="Delete" Icon="Delete28" Appearance="Danger" Click="Delete_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</base:WpfUiWindow>