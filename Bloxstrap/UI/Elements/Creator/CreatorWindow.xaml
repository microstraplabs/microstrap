<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Creator.CreatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Microstrap Creator" Width="720" SizeToContent="Height"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="8" Title="Microstrap Creator" Icon="pack://application:,,,/Microstrap.ico" />
        <StackPanel Grid.Row="1" Margin="26,20,26,28">
            <TextBlock Text="Create without limits" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" Text="Build a theme with images, fonts, custom XML, and the existing element library. Projects are saved in Microstrap's shared CustomThemes folder." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ui:CardAction Grid.Column="0" Margin="0,0,6,0" Icon="Add28" Click="NewProject_Click">
                    <StackPanel><TextBlock Text="New project" FontSize="15" FontWeight="SemiBold"/><TextBlock Margin="0,4,0,0" Text="Start from a blank or simple template." FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></StackPanel>
                </ui:CardAction>
                <ui:CardAction Grid.Column="1" Margin="6,0,0,0" Icon="FolderOpen24" Click="Dashboard_Click">
                    <StackPanel><TextBlock Text="My Dashboard" FontSize="15" FontWeight="SemiBold"/><TextBlock Margin="0,4,0,0" Text="Return to saved creations." FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></StackPanel>
                </ui:CardAction>
            </Grid>
            <Border Margin="0,20,0,0" Padding="16" CornerRadius="10" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <StackPanel>
                    <TextBlock Text="Creator toolkit" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Text="• XML editor with element and attribute autocomplete&#x0a;• Preview, save, and publish your project as a shareable ZIP&#x0a;• Add pictures and fonts by placing them in the project folder" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</base:WpfUiWindow>