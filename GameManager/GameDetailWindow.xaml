<ui:UiWindow x:Class="Bloxstrap.GameManager.GameDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Name}"
    Width="720" Height="560" MinWidth="620" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#11101A" Foreground="White"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#19152A" Offset="0" />
                <GradientStop Color="#0D0D14" Offset="0.58" />
                <GradientStop Color="#24183D" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ui:TitleBar Title="{Binding Name}" Icon="pack://application:,,,/Microstrap.ico" Padding="14,8" ShowMinimize="False" ShowMaximize="False" ShowClose="True" CanMaximize="False" />

        <Grid Margin="36,52,36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: icon, name, creator, stats -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="120" Height="120" CornerRadius="26" Background="#2D2647" BorderBrush="#5D4C8B" BorderThickness="1">
                    <Image Margin="10" Source="{Binding Game.ThumbnailUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Game.Name}" FontSize="28" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Game.Creator, StringFormat=by {0}}" FontSize="15" Foreground="#C2BBD3" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Padding="10,4" CornerRadius="10" Background="#20FFFFFF" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◉" FontSize="13" Foreground="#73E2A3" />
                                <TextBlock Margin="6,0,0,0" Text="{Binding PlayingText}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Margin="4,0,0,0" Text="playing" FontSize="13" Foreground="#9E96B3" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,4" CornerRadius="10" Background="#20FFFFFF" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↗" FontSize="14" Foreground="#F5B84B" />
                                <TextBlock Margin="6,0,0,0" Text="{Binding VisitsText}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Margin="4,0,0,0" Text="visits" FontSize="13" Foreground="#9E96B3" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,4" CornerRadius="10" Background="#20FFFFFF" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="★" FontSize="14" Foreground="#7EB1FF" />
                                <TextBlock Margin="6,0,0,0" Text="{Binding FavoritesText}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Margin="4,0,0,0" Text="favorites" FontSize="13" Foreground="#9E96B3" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,4" CornerRadius="10" Background="#20FFFFFF">
                            <TextBlock Text="{Binding Game.Genre}" FontSize="13" Foreground="#C2BBD3" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Description -->
            <Border Grid.Row="1" Padding="20" CornerRadius="16" Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding DescriptionText}" FontSize="14" LineHeight="22" Foreground="#E3DDF0" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- Footer stats + play -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#9E96B3">
                    <Run Text="Updated " /><Run Text="{Binding UpdatedText, Mode=OneWay}" /><Run Text=" · max " /><Run Text="{Binding Game.MaxPlayers, Mode=OneWay}" /><Run Text=" players" />
                </TextBlock>
                <ui:Button Grid.Column="1" Content="Play now" Icon="Play24" Appearance="Primary" FontSize="14" Padding="24,8" Command="{Binding PlayCommand}" />
            </Grid>
        </Grid>
    </Grid>
</ui:UiWindow>
